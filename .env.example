# Supabase (클라이언트)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase (SSR/server functions)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# 메일 (없으면 시뮬레이션 모드로 동작)
RESEND_API_KEY=
RESEND_FROM=noreply@example.com
# 메일 {접속링크}·AI 프록시 origin 에 쓰이는 운영 URL. 운영: https://www.jdsurvey.seoyoneh.com
APP_URL=http://localhost:8080

# AI 프록시 (미설정 시 기본 워커로 폴백하되 관리자 화면에 경고 표시)
ELIZAX_PROXY_URL=https://elizax-proxy.baldr0001.workers.dev

# 배포 전용(GitHub Secrets): ENABLE_CRON=1 이면 예약발송·리마인더 cron 트리거 등록
# (CF 무료 플랜 계정당 cron 5개 상한 주의)
